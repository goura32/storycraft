{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storycraft://schemas/scene_commit.json",
  "title": "Storycraft V1 Scene Commit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_prose_id",
    "continuity_update_id",
    "current_state_id",
    "scene_card_id",
    "quality_disposition_id"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "scene_prose_id": {
      "type": "string",
      "pattern": "^scene-v[0-9]{2}-c[0-9]{2}-s[0-9]{2}-[0-9]{6}$"
    },
    "continuity_update_id": {
      "type": "string",
      "pattern": "^continuity-v[0-9]{2}-c[0-9]{2}-s[0-9]{2}-[0-9]{6}$"
    },
    "current_state_id": {
      "type": "string",
      "pattern": "^gen-[0-9]{6}$"
    },
    "scene_card_id": {
      "type": "string",
      "pattern": "^scene-card-v[0-9]{2}-c[0-9]{2}-s[0-9]{2}-[0-9]{6}$"
    },
    "quality_disposition_id": {
      "type": "string",
      "pattern": "^quality-[0-9]{6}$"
    }
  }
}