{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storycraft Request Intake Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "genre",
    "premise",
    "required_elements",
    "avoid",
    "ending_preference",
    "volume_count",
    "language"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "genre": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "premise": {
      "type": "string",
      "minLength": 1
    },
    "required_elements": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "avoid": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ending_preference": {
      "type": "string",
      "minLength": 1
    },
    "volume_count": {
      "type": "integer",
      "minimum": 4,
      "maximum": 10
    },
    "language": {
      "type": "string",
      "const": "ja"
    }
  }
}