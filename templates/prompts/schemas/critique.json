{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "issues"],
  "properties": {
    "schema_version": {"const": "review-response-v1"},
    "decision": {"type": "string", "enum": ["pass", "issues"]},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "evidence_locations", "explanation"],
        "properties": {
          "severity": {"type": "string", "enum": ["critical", "notice"]},
          "evidence_locations": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "pattern": "^(?:\\$\\.[A-Za-z_][A-Za-z0-9_]*(?:(?:\\.[A-Za-z_][A-Za-z0-9_]*)|(?:\\[(?:[0-9]+|\"(?:[^\"\\\\]|\\\\.)*\")\\]))*|prose:[0-9]+|paragraph:[0-9]+)$"}
          },
          "explanation": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
