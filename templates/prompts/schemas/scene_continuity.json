{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storycraft V1 Continuity Update Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["coordinate", "changes"],
  "properties": {
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume_number", "chapter_number", "scene_number"],
      "properties": {
        "volume_number": {"type": "integer", "minimum": 1},
        "chapter_number": {"type": "integer", "minimum": 1},
        "scene_number": {"type": "integer", "minimum": 1}
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "target", "path", "value", "evidence_locations"],
        "properties": {
          "op": {"type": "string", "enum": ["set", "add", "remove"]},
          "target": {
            "type": "string",
            "enum": [
              "story_facts",
              "character_knowledge",
              "reader_disclosures",
              "unresolved_thread_states",
              "timeline_position"
            ]
          },
          "path": {"type": "string", "minLength": 1},
          "value": {},
          "evidence_locations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
