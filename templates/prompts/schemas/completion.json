{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storycraft V1 Completion Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "thread_checks",
    "ending_checks",
    "character_arc_checks",
    "relationship_arc_checks",
    "issues"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "complete_with_issues",
        "incomplete"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "thread_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "thread_id",
          "required_for_completion",
          "status",
          "evidence_scene_ids",
          "assessment",
          "issues"
        ],
        "properties": {
          "thread_id": {
            "type": "string",
            "pattern": "^thread-[A-Za-z0-9_-]+$"
          },
          "required_for_completion": {
            "const": true
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "open",
              "progressing",
              "resolved",
              "abandoned"
            ]
          },
          "evidence_scene_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^scene-v[0-9]{2}-c[0-9]{3}-s[0-9]{3}$"
            }
          },
          "assessment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "issues": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    },
    "ending_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "status",
          "evidence_scene_ids",
          "assessment",
          "issues"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^ending-(desired-effect|required-outcome-[0-9]{3}|forbidden-outcome-[0-9]{3}|final-revelation-[0-9]{3})$"
          },
          "status": {
            "type": "string",
            "enum": [
              "satisfied",
              "partially_satisfied",
              "not_satisfied",
              "not_applicable"
            ]
          },
          "evidence_scene_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^scene-v[0-9]{2}-c[0-9]{3}-s[0-9]{3}$"
            }
          },
          "assessment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "issues": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      }
    },
    "character_arc_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "character_id",
          "planned_end_state",
          "actual_end_state",
          "status",
          "evidence_scene_ids",
          "assessment"
        ],
        "properties": {
          "character_id": {
            "type": "string",
            "pattern": "^char-[A-Za-z0-9_-]+$"
          },
          "planned_end_state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "actual_end_state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "status": {
            "type": "string",
            "enum": [
              "satisfied",
              "partially_satisfied",
              "not_satisfied",
              "not_applicable"
            ]
          },
          "evidence_scene_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^scene-v[0-9]{2}-c[0-9]{3}-s[0-9]{3}$"
            }
          },
          "assessment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          }
        }
      }
    },
    "relationship_arc_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relationship_id",
          "planned_end_state",
          "actual_end_state",
          "status",
          "evidence_scene_ids",
          "assessment"
        ],
        "properties": {
          "relationship_id": {
            "type": "string",
            "pattern": "^rel-[A-Za-z0-9_-]+$"
          },
          "planned_end_state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "actual_end_state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "status": {
            "type": "string",
            "enum": [
              "satisfied",
              "partially_satisfied",
              "not_satisfied",
              "not_applicable"
            ]
          },
          "evidence_scene_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^scene-v[0-9]{2}-c[0-9]{3}-s[0-9]{3}$"
            }
          },
          "assessment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "description"
        ],
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          }
        }
      }
    }
  }
}
